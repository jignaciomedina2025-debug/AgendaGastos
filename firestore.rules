rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function sameFamily(familyId) {
      return hasProfile() && userDoc().familyId == familyId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (hasProfile() && resource.data.familyId == userDoc().familyId)
      );
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.familyId is string;
      allow update: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      // Needed during registration (invite lookup) before profile exists.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inviteCode is string;
      allow update: if sameFamily(familyId);
    }

    match /purchases/{purchaseId} {
      allow read: if sameFamily(resource.data.familyId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && sameFamily(request.resource.data.familyId);
      allow update: if sameFamily(resource.data.familyId);
    }

    match /cards/{cardId} {
      allow read: if sameFamily(resource.data.familyId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && sameFamily(request.resource.data.familyId)
        && request.resource.data.brand is string
        && request.resource.data.lastFour is string;
      allow update, delete: if sameFamily(resource.data.familyId);
    }

    match /monthly_statements/{statementId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
